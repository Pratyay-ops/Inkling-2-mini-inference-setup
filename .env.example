# Copy to .env (scripts/up.sh does this on first run). .env is git-ignored.

# --- Image and model (pinned; change both together and re-run scripts/download-model.sh) ---
# vLLM build 0.1.dev25855+g7cb5dae22 (cu130), the same build the public GB10 recipes measured.
VLLM_IMAGE=vllm/vllm-openai:inkling-2-mini@sha256:c2dc759f5984f69c1e2418c6af7c26eb756f5ed2a8934c768ae1253645d1449e
MODEL_ID=thinkingmachines/Inkling-2-Mini
MODEL_REVISION=7a67ae2314b44ef05c87fd1d4d311c58aaeb18f6
SERVED_MODEL_NAME=inkling-2-mini

# --- Proxy (the only thing clients can reach; vLLM itself publishes no port) ---
# nginx 1.30.8 stable, arm64.
PROXY_IMAGE=nginx:stable-alpine@sha256:8eb2b5540eae779603cc3db84b3986a15ecb5308b54303146eee9837c137b51a
# 127.0.0.1 (default): only this box can connect; also right when a tunnel (cloudflared, tailscale) on this
# box is the way in. 0.0.0.0 exposes the proxy on the LAN over plain HTTP. Docker-published ports bypass
# ufw, so the per-client keys are then the only gate. See docs/SECURITY.md before changing it.
BIND_ADDRESS=127.0.0.1
PORT=8000
# Per-key request rate and burst, per-key concurrent requests, and per-IP rate (also throttles key guessing).
PROXY_RATE_PER_KEY=20r/s
PROXY_BURST_PER_KEY=40
PROXY_MAX_CONCURRENT_PER_KEY=64
PROXY_RATE_PER_IP=30r/s
# Largest request body (base64 images count here) and longest wait for a response.
PROXY_MAX_BODY=32m
PROXY_READ_TIMEOUT=3600s

# --- Public access ---
# none: localhost only (BIND_ADDRESS). tailscale-funnel: this host's Tailscale publishes the proxy at
# https://<node>.<tailnet>.ts.net (free Personal plan; outbound-only; TLS ends on this box). The proxy's
# Funnel listener is always on 127.0.0.1:FUNNEL_PORT; turn publishing on with scripts/funnel.sh enable.
PUBLIC_ACCESS=none
FUNNEL_PORT=8001

# --- Secrets (outside the repo; scripts/up.sh creates them, mode 600) ---
# internal-key (vLLM's own key, never given to clients), nginx/clients.map (scripts/keys.sh),
# nginx/upstream-auth.conf (generated from internal-key).
SECRETS_DIR=${HOME}/.config/inkling

# --- Storage (user-owned; the HF cache is mounted read-only into the container) ---
HF_HOME_DIR=${HOME}/.cache/inkling/huggingface
VLLM_CACHE_DIR=${HOME}/.cache/inkling/vllm

# --- Engine tuning (see README "Tuning") ---
# 262144 is the official DGX Spark context cap. The model supports 1M with a larger KV budget.
MAX_MODEL_LEN=262144
# Concurrent sequences per step. 32 is where community GB10 numbers peak (~244 tok/s aggregate).
MAX_NUM_SEQS=32
# Prefill chunk per step. Drop to 2048 (or 1024) if you hit the sm_121 shared-memory crash (vllm#69012).
MAX_NUM_BATCHED_TOKENS=8192
# Cap on the 128 GB unified memory vLLM may take while active (weights ~19 GiB + runtime ~7 GiB + KV cache).
# 0.45 = ~55 GiB: fits one full 262K-token request, or 32 chat users (measured prefill peak ~25 GiB of KV).
# Idle (CACHE_IDLE_MINUTES) drops to weights + runtime. Raise it for several long documents at once; a
# unified-memory OOM can hang GB10 until a power cycle, so leave room for the rest of the box.
GPU_MEMORY_UTILIZATION=0.45
# auto (BF16) or fp8. FP8 gives ~1.45x more KV tokens but measurably longer reasoning and slightly lower tool-eval scores.
KV_CACHE_DTYPE=auto
# dspark (bundled MTP drafter, 7 tokens) or off. dspark wins on code and under concurrency, ties on chat.
SPEC_DECODE=dspark
# Wipe every cache (prefix, image, KV memory) after this many minutes without API requests; the next request
# waits a few seconds while it's re-reserved. 0 = keep caches (no sleep mode). Health checks don't count.
CACHE_IDLE_MINUTES=15
# Python 3.13 alpine, arm64 (runs docker/cache_reaper.py).
REAPER_IMAGE=python:3.13-alpine@sha256:9ef1a599f863231c3d91e941389bfdc4a2d6070557243d54df1a4e57015b960e
# Extra vllm serve flags, whitespace-separated.
EXTRA_ARGS=
